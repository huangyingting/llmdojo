# Database configuration
# Local development uses SQLite (file:./dev.db)
# Production uses PostgreSQL (postgresql://user:password@host:5432/llmdojo?schema=public)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-32-byte-cryptographic-secret-in-production"

# Initial administrator bootstrap (used ONLY by `npm run bootstrap:admin` CLI script)
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ReplaceWithStrongPassword123!"
BOOTSTRAP_ADMIN_NAME="Platform Administrator"
